{
  "protocol": 1,
  "source_prefixes": {
    "web": "/web",
    "app": "/app",
    "esp32": "/esp32"
  },
  "types": {
    "/brain/info": "std_msgs/msg/String",
    "/cmd_vel": "geometry_msgs/msg/Twist",
    "/config": "std_msgs/msg/String",
    "/config_url": "std_msgs/msg/String",
    "/expression": "std_msgs/msg/String",
    "/goal_pose": "geometry_msgs/msg/PoseStamped",
    "/gps/fix": "sensor_msgs/msg/NavSatFix",
    "/hello": "std_msgs/msg/String",
    "/imu/data": "sensor_msgs/msg/Imu",
    "/initialpose": "geometry_msgs/msg/PoseWithCovarianceStamped",
    "/joint_states": "sensor_msgs/msg/JointState",
    "/look_at": "geometry_msgs/msg/PoseStamped",
    "/nav/command": "std_msgs/msg/String",
    "/odom": "nav_msgs/msg/Odometry",
    "/phone/config": "std_msgs/msg/String",
    "/phone/config_url": "std_msgs/msg/String",
    "/ping": "std_msgs/msg/String",
    "/pong": "std_msgs/msg/String",
    "/scan": "sensor_msgs/msg/LaserScan",
    "/servo/command": "trajectory_msgs/msg/JointTrajectory",
    "/speech/audio": "audio_common_msgs/msg/AudioData",
    "/speech/recognized": "std_msgs/msg/String",
    "/speech/say": "std_msgs/msg/String",
    "/vision/config": "std_msgs/msg/String",
    "/vision/detections": "vision_msgs/msg/Detection2DArray",
    "/vision/markers": "std_msgs/msg/String",
    "/webrtc/answer": "std_msgs/msg/String",
    "/webrtc/app_ice": "std_msgs/msg/String",
    "/webrtc/offer": "std_msgs/msg/String",
    "/webrtc/preview": "std_msgs/msg/String",
    "/webrtc/web_answer": "std_msgs/msg/String",
    "/webrtc/web_ice": "std_msgs/msg/String",
    "/webrtc/web_offer": "std_msgs/msg/String",
    "/wheel_vel": "smabo_interfaces/msg/WheelVel"
  },
  "publish": {
    "web": [
      "/cmd_vel",
      "/servo/command",
      "/initialpose",
      "/goal_pose",
      "/nav/command",
      "/speech/say",
      "/expression",
      "/look_at",
      "/ping",
      "/vision/config",
      "/webrtc/preview",
      "/webrtc/web_answer",
      "/webrtc/web_ice",
      "/hello"
    ],
    "app": [
      "/imu/data",
      "/gps/fix",
      "/speech/audio",
      "/webrtc/offer",
      "/webrtc/app_ice",
      "/phone/config",
      "/phone/config_url",
      "/hello"
    ],
    "esp32": [
      "/config",
      "/wheel_vel",
      "/joint_states",
      "/scan",
      "/pong",
      "/config_url",
      "/hello"
    ]
  },
  "subscribe": {
    "web": [
      "/odom",
      "/pong",
      "/speech/recognized",
      "/imu/data",
      "/gps/fix",
      "/vision/config",
      "/vision/detections",
      "/vision/markers",
      "/webrtc/web_offer",
      "/config",
      "/config_url",
      "/phone/config",
      "/phone/config_url",
      "/brain/info"
    ],
    "app": [
      "/expression",
      "/look_at",
      "/speech/say",
      "/webrtc/answer",
      "/brain/info"
    ],
    "esp32": [
      "/cmd_vel",
      "/servo/command",
      "/ping",
      "/brain/info"
    ]
  },
  "ros_only_topics": [
    "/goal_pose",
    "/initialpose",
    "/nav/command"
  ],
  "app_topics": [
    "/expression",
    "/look_at",
    "/speech/say"
  ],
  "from_brain": [
    "/odom",
    "/brain/info",
    "/vision/config",
    "/vision/detections",
    "/vision/markers",
    "/speech/recognized",
    "/webrtc/web_offer",
    "/webrtc/answer"
  ],
  "notes": {
    "/brain/info": "brain のプロトコル番号と版（JSON）。接続時と /hello の後",
    "/cmd_vel": "走行指令（速度と角速度）",
    "/config": "ESP32 の設定の写し（Wi-Fi を除く JSON）。変わったとき。web は REST で読み直す",
    "/config_url": "ESP32 の設定 REST API の場所（http://ip:port）。5 秒ごと",
    "/expression": "表情の名前（大文字小文字は区別しない）",
    "/goal_pose": "ナビゲーションの目的地（smabo-brain-ros のみ）",
    "/gps/fix": "スマホの GPS",
    "/hello": "クライアントのプロトコル番号と版（JSON）。接続のたびに 1 回",
    "/imu/data": "スマホの IMU",
    "/initialpose": "自己位置の初期値（smabo-brain-ros のみ）",
    "/joint_states": "サーボの角度",
    "/look_at": "目で追う先",
    "/nav/command": "SLAM・地図保存・ナビゲーションの指示（JSON、smabo-brain-ros のみ）",
    "/odom": "車輪の速度から積分した自己位置",
    "/phone/config": "スマホの設定の全体（JSON）。変わったとき",
    "/phone/config_url": "スマホの設定 REST API の場所。5 秒ごと",
    "/ping": "WebSocket の往復確認（web → ESP32）",
    "/pong": "/ping の応答（ESP32 → web）",
    "/scan": "LiDAR の距離",
    "/servo/command": "サーボの軌道",
    "/speech/audio": "録音した音声（base64 の WAV）。brain が文字にする",
    "/speech/recognized": "音声認識の結果",
    "/speech/say": "読み上げる文字列",
    "/vision/config": "画像処理の設定（JSON）",
    "/vision/detections": "画像処理の検出結果",
    "/vision/markers": "AR マーカー番号・QR の内容",
    "/webrtc/answer": "WebRTC のシグナリング（brain → app）",
    "/webrtc/app_ice": "WebRTC のシグナリング（app → brain）",
    "/webrtc/offer": "WebRTC のシグナリング（app → brain）",
    "/webrtc/preview": "プレビュー映像の開始・停止",
    "/webrtc/web_answer": "WebRTC のシグナリング（web → brain）",
    "/webrtc/web_ice": "WebRTC のシグナリング（web → brain）",
    "/webrtc/web_offer": "WebRTC のシグナリング（brain → web）",
    "/wheel_vel": "左右の車輪の速度。brain が /odom に積分する"
  },
  "to_brain": [
    "/hello",
    "/wheel_vel",
    "/joint_states",
    "/speech/audio",
    "/webrtc/offer",
    "/webrtc/app_ice",
    "/webrtc/web_answer",
    "/webrtc/web_ice",
    "/webrtc/preview",
    "/vision/config",
    "/config"
  ]
}
